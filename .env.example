# ── Gemini API (Writes the HR Wellbeing Report) ──────────────────────────────
# Paste your Google Gemini API key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Server-side key (used by Netlify Functions in production)
GEMINI_API_KEY=

# Optional: Custom Report Endpoint (if using Netlify serverless function)
# VITE_REPORT_ENDPOINT=/.netlify/functions/generate-report

# ── Supabase (Stores Live Anonymous Check-Ins) ──────────────────────────────
# From your Supabase Project Settings -> API:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Firebase (Optional) ──────────────────────────────────────────────────────
# If unset, local demo authentication & storage is used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
